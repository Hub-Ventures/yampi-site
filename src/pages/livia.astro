---
// Livia — los agentes de IA que operan adentro del sistema.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Swap from '../components/Swap.astro';
import NextCards from '../components/NextCards.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Replaces from '../components/Replaces.astro';
import { reemplaza } from '../lib/logos.js';

const DESCRIPTION =
  'Livia no es un bot que responde: son agentes que operan. Le cargas el conocimiento de tu inmobiliaria, defines qué puede hacer y hasta dónde, y trabaja adentro de tus procesos.';

// Un agente se arma en tres capas: qué sabe, qué puede hacer y cómo se comporta.
// El orden importa —el conocimiento condiciona las acciones, y las acciones
// condicionan el comportamiento—, así que la numeración es información.
const capas = [
  {
    num: '01',
    title: 'Lo que sabe',
    text: 'Le cargas los documentos, las preguntas frecuentes y los escenarios de tu inmobiliaria. Responde con eso, no con lo que se imagine.',
    replaces: reemplaza(['ChatGPT', 'Notion', 'Manual de inducción']),
  },
  {
    num: '02',
    title: 'Lo que puede hacer',
    text: 'Habilidades y herramientas: consultar el inventario, agendar una visita, mirar un pago, crear el requerimiento. Tú eliges cuáles quedan activas.',
    replaces: reemplaza(['Zapier', 'Make', 'n8n']),
  },
  {
    num: '03',
    title: 'Cómo se comporta',
    text: 'Pautas de respuesta y protecciones. Cómo saluda, qué no debe decir y en qué momento pasa la conversación a una persona.',
    replaces: reemplaza(['ManyChat', 'Guiones en Word']),
  },
];

const control = [
  {
    title: 'Protecciones',
    text: 'Escribes lo que el agente no puede hacer ni afirmar. Si la conversación llega ahí, se detiene y avisa.',
    icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
  },
  {
    title: 'Cierre y transferencia',
    text: 'Defines cuándo entrega la conversación a un asesor. El asesor la recibe con todo el contexto leído.',
    icon: 'M16 3h5v5M21 3l-7 7M8 21H3v-5M3 21l7-7',
  },
  {
    title: 'Pruébalo antes',
    text: 'Cada agente tiene su sala de pruebas: le escribes como si fueras el cliente y ves qué contesta antes de soltarlo.',
    icon: 'M9 3h6l-1 4 4 10a3 3 0 0 1-3 4H9a3 3 0 0 1-3-4l4-10z',
  },
];

const antes = [
  'Alguien pendiente del WhatsApp hasta la noche',
  'Repetir las mismas diez preguntas cada día',
  'Perfilar al interesado a mano, si hay tiempo',
  'Cuadrar la visita por chat, mensaje por mensaje',
  'Armar el reporte del mes copiando y pegando',
];

const despues = [
  'Contesta a cualquier hora, con tu información',
  'Perfila mientras conversa y lo deja registrado',
  'Agenda con la disponibilidad real del asesor',
  'Escala a una persona cuando toca decidir',
  'El reporte sale del dato que ya está adentro',
];

const sigue = [
  { kicker: 'Suite Comercial', href: '/suites/comercial/', title: 'Del interesado al negocio', text: 'Lo que Livia perfila entra al tablero de oportunidades con su inmueble.', cta: 'Ver la suite' },
  { kicker: 'Suite Servicio', href: '/suites/servicio/', title: 'Requerimientos con plazo', text: 'Livia radica lo que piden inquilinos y propietarios, y le pone reloj.', cta: 'Ver la suite' },
  { kicker: 'Suite Administrativa', href: '/suites/administrativa/', title: 'Contratos y cobros', text: 'Firma electrónica, cobro del arriendo y giro al propietario.', cta: 'Ver la suite' },
];
---
<BaseLayout title="Livia — Agentes de IA para tu inmobiliaria | Yampi" description={DESCRIPTION}>

  <PageHero
    accent="yampi"
    badge="Livia"
    title="No es un bot que responde.<br />Son agentes que operan."
    lede="Le cargas el conocimiento de tu inmobiliaria, le defines qué puede hacer y hasta dónde, y trabaja adentro de tus procesos. Tu equipo deja de ejecutar y pasa a supervisar."
    secondaryLabel="Cómo se configura"
    secondaryHref="#agentes"
    shot={{
      src: '/screenshots/chat-oscuro.png',
      alt: 'Livia respondiendo una conversación de WhatsApp dentro de la bandeja de Yampi',
    }}
  />

  <section class="section section-paper" id="agentes">
    <div class="wrap">
      <h2 class="display-md reveal">Un agente se arma en tres capas</h2>
      <p class="lede reveal" style="max-width: 660px; margin-top: 18px;">Qué sabe, qué puede hacer y cómo se comporta. Las tres se editan sin escribir código.</p>
      <div class="layer-grid reveal">
        {capas.map((c) => (
          <div class="layer-card">
            <span class="layer-num">{c.num}</span>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
            <Replaces items={c.replaces} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="wrap">
      <h2 class="display-md reveal">Tú pones los límites</h2>
      <p class="lede reveal" style="max-width: 660px; margin-top: 18px;">Livia habla con tus clientes, así que lo primero que se configura es hasta dónde llega.</p>
      <div class="control-grid reveal">
        {control.map((c) => (
          <div class="control-card">
            <span class="control-icon">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={c.icon}></path></svg>
            </span>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap">
      <div class="section-head-center reveal">
        <h2 class="display-md">Lo que Livia reemplaza</h2>
        <p class="lede" style="margin-top: 18px;">No es una herramienta más encima de las que tienes: es el trabajo que hoy hace alguien a mano.</p>
      </div>
      <Swap antes={antes} despues={despues} despuesLabel="Con Livia" narrow />
    </div>
  </section>

  <NextCards items={sigue} />

  <CtaFinal />
</BaseLayout>
