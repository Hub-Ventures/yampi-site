---
// Home del sitio comercial Yampi.
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Shot from '../components/Shot.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import FlowRow from '../components/FlowRow.astro';
import Swap from '../components/Swap.astro';
import { SISTEMA_BASE, SUPERFICIES, SUITES, LIVIA } from '../lib/platform.js';
import { reemplaza } from '../lib/logos.js';
import { HOME_PAGE_TITLE, HOME_HERO_TITLE, HOME_HERO_DESCRIPTION, getGoogleSignupUrl } from '../lib/site-copy.js';

// Apagado hasta tener logos reales de cliente.
const MOSTRAR_LOGOS = false;

const notas = [
  {
    title: 'Contactos vive en tu suite, no en todas',
    text: 'Un asesor comercial y uno de cartera abren el mismo contacto desde su propia suite. Nadie se mete en la cartera del otro ni ve lo que no le toca.',
    icon: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 3a4 4 0 1 1 0 8 4 4 0 0 1 0-8M22 21v-2a4 4 0 0 0-3-3.9',
  },
  {
    title: 'La firma empieza donde se usa',
    text: 'Firmar contratos arranca dentro de la suite administrativa, pegado al cobro que habilita. Los documentos firmados, en cambio, son de todos: viven en la biblioteca del sistema base, donde cualquiera los consulta.',
    icon: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M12 18v-6M9 15l3-3 3 3',
  },
];

const momentos = [
  {
    num: '01',
    title: 'Alguien pregunta por un apartamento',
    text: 'El mensaje entra por WhatsApp, Instagram o el chat de tu página y cae en una sola bandeja. Livia contesta al momento: pregunta qué busca, manda las fotos y cuadra la visita con el asesor que le toca. Cuando el asesor entra a responder, ya sabe todo lo que se habló.',
    links: ['Chats', 'Livia · Asistente IA', 'Centro de Ayuda', 'Niveles de servicio'],
    replaces: reemplaza(['WhatsApp Business', 'Zendesk', 'ManyChat']),
    shot: {
      src: '/screenshots/contacto-detalle.png',
      ratio: '918 / 540',
      alt: 'Ficha de un contacto con la conversación, la propiedad de interés y la etapa del negocio',
    },
    flip: false,
  },
  {
    num: '02',
    title: 'Ese interesado se vuelve un negocio',
    text: 'El inmueble deja de ser una fila en una hoja de cálculo: es una ficha con fotos, estado y dueño, amarrada al negocio y a la persona. En el tablero ves en qué etapa va cada uno, cuánto vale y quién responde por él.',
    links: ['Contactos y Empresas', 'Propiedades', 'Calendario', 'Oportunidades', 'Perfil del asesor'],
    replaces: reemplaza(['Domus', 'SIMI', 'HubSpot']),
    shot: {
      src: '/screenshots/pipeline-tablero.png',
      alt: 'Tablero de negocios por etapa, con el valor de cada oportunidad',
    },
    flip: true,
  },
  {
    num: '03',
    title: 'Se firma, y empieza a entrar plata',
    text: 'El contrato se firma con un código que llega por WhatsApp, sin imprimir ni instalar nada. Al quedar firmado el cobro queda andando: el inquilino paga por PSE o deja su tarjeta, y cada mes lo del propietario sale con la comisión y la administración ya descontadas.',
    links: ['Firma electrónica de contratos', 'Tesorería y Cobros'],
    replaces: reemplaza(['Excel', 'Arrendasoft', 'DocuSign']),
    shot: {
      src: '/screenshots/tesoreria.png',
      alt: 'Reglas de cobro de tesorería: moneda, día de cobro, días de gracia y automatizaciones',
    },
    flip: false,
  },
  {
    num: '04',
    title: 'Y la operación aguanta crecer',
    text: 'Le dices a Yampi qué hacer cuando algo pasa y lo hace siempre igual: repartir los mensajes según quién esté libre, avisar de un pago vencido, mover un negocio de etapa. Y cada persona del equipo ve solo lo que le toca ver.',
    links: ['Automatizaciones', 'Campañas', 'Informes'],
    replaces: reemplaza(['Zapier', 'Make', 'ChatGPT']),
    shot: {
      src: '/screenshots/cuenta.png',
      ratio: '918 / 534',
      alt: 'Configuración de la cuenta: equipos, permisos y aplicaciones',
    },
    flip: true,
  },
];

const antes = [
  'Un CRM que no sabe de arriendos',
  'La bandeja de WhatsApp por aparte',
  'El Excel de cobros y cartera',
  'Contratos que van y vienen por correo',
  'La pasarela de pagos en otra cuenta',
  'La hoja de propiedades y los portales',
];

const despues = [
  'Todos los canales en una bandeja, con IA',
  'Contactos, inmuebles y negocios conectados',
  'Contratos con firma electrónica',
  'Cobro del arriendo y giro al propietario',
  'Automatizaciones y reportes',
  'Una sola cuenta, sin conectar nada',
];
---
<BaseLayout title={HOME_PAGE_TITLE} description={HOME_HERO_DESCRIPTION}>

  <section class="hero-claro">
    <div class="hero-claro-inner">
      <div class="hero-claro-copy">
        <h1 class="display-xl">{HOME_HERO_TITLE}</h1>
        <p class="lede">{HOME_HERO_DESCRIPTION}</p>
      </div>
      <div class="hero-actions">
        <Button variant="google" size="lg" href={getGoogleSignupUrl()} label="Comenzar con Google" />
        <Button action="demo" size="lg" />
      </div>
    </div>
    <div class="hero-shot">
      <Shot
        src="/screenshots/chat-bandeja.png"
        alt="Bandeja de conversaciones de Yampi: WhatsApp, la propiedad de interés y la etapa del negocio en una sola pantalla"
        priority
      />
    </div>
  </section>

  {MOSTRAR_LOGOS && (
    <section class="logos-band">
      <div class="wrap">
        <p>Inmobiliarias que operan con Yampi</p>
        <div class="logos-row">
          {[1, 2, 3, 4, 5].map(() => <div class="logo-ph">Logo cliente</div>)}
        </div>
      </div>
    </section>
  )}

  <section class="section" id="plataforma">
    <div class="wrap">
      <h2 class="display-lg reveal">La operación de siempre, pero controlada,<br />organizada y automatizada</h2>
      <p class="lede reveal" style="max-width: 720px; margin-top: 20px;">Usa lo que realmente necesita tu equipo, y escala tus operaciones con la ayuda de Livia, la Inteligencia Artificial para tus operaciones inmobiliarias.</p>

      <div class="arch reveal">
        <div class="arch-base">
          <div class="arch-base-head">
            <h3>{SISTEMA_BASE.label}</h3>
            <p>{SISTEMA_BASE.tagline}</p>
          </div>
          <div class="arch-surfaces">
            {SUPERFICIES.map((s) => (
              <a class="arch-surface" href={SISTEMA_BASE.href}>
                <span class="arch-surface-icon">
                  <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={s.icon}></path></svg>
                </span>
                <span class="arch-surface-label">{s.label}</span>
                <span class="arch-surface-note">{s.note}</span>
              </a>
            ))}
          </div>
        </div>

        <div class="arch-suites">
          {SUITES.map((s) => (
            <div class="arch-suite">
              <span class="arch-suite-num">{s.num}</span>
              <h3>{s.label}</h3>
              <div class="arch-suite-accent" style={`background: ${s.color};`}></div>
              <p class="arch-suite-tagline">{s.tagline}</p>
              <p class="arch-suite-quien">La habita {s.quien}</p>
              <div class="arch-suite-items">
                {s.items.map((item) => (
                  <a href={s.href}>
                    <span>{item}</span>
                    <Icon name="arrow-right" size={14} />
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>

        <div class="arch-livia">
          <div class="arch-livia-id">
            <span class="arch-livia-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v2M7.5 7h9a2.5 2.5 0 0 1 2.5 2.5v6A2.5 2.5 0 0 1 16.5 18h-9A2.5 2.5 0 0 1 5 15.5v-6A2.5 2.5 0 0 1 7.5 7zM9.5 12h.01M14.5 12h.01M3 11v3M21 11v3M9 21h6"></path></svg>
            </span>
            <div>
              <h3>Livia</h3>
              <p>Atraviesa todo lo de arriba</p>
            </div>
          </div>
          <p class="arch-livia-text">No es una pantalla que se visita: se configura una vez —qué sabe, qué puede hacer y en qué bandejas entra— y desde ahí trabaja adentro del sistema base y de las tres suites. Contesta, agenda, clasifica y avisa con el mismo dato que ve tu equipo.</p>
          <a class="btn btn-primary" href={LIVIA.href}>Conoce a Livia</a>
        </div>
      </div>

      <div class="notas reveal">
        {notas.map((n) => (
          <div class="nota">
            <span class="nota-icon">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={n.icon}></path></svg>
            </span>
            <div>
              <h4>{n.title}</h4>
              <p>{n.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-paper" id="recorrido">
    <div class="wrap">
      <span class="kicker reveal">Cómo funciona</span>
      <h2 class="display-lg reveal" style="margin-top: 14px;">Un arriendo en Yampi,<br />de principio a fin</h2>
      <p class="lede reveal" style="max-width: 680px; margin-top: 18px;">Cuatro momentos del mismo negocio. Lo que queda registrado en el primero es lo que evita repetir trabajo en el último.</p>
      <div class="flow">
        {momentos.map((m) => <FlowRow {...m} />)}
      </div>
    </div>
  </section>

  <section class="section section-tint" id="reemplazas">
    <div class="wrap">
      <div class="section-head-center reveal">
        <span class="kicker">Una sola cuenta</span>
        <h2 class="display-lg" style="margin-top: 14px;">Una plataforma en vez de<br />seis herramientas sueltas</h2>
        <p class="lede" style="margin-top: 18px;">Hoy la operación vive repartida y alguien tiene que pasar los datos a mano de un lado al otro. Ahí se pierden los interesados, se descuadra la cartera y se van las horas.</p>
      </div>
      <Swap antesLabel="Como está hoy" antes={antes} despues={despues} />
    </div>
  </section>

  <CtaFinal
    title="Míralo con tus<br />propias propiedades."
    text="Nos cuentas cómo arriendas y cobras hoy, y te mostramos cómo quedaría con tus propios inmuebles. Treinta minutos, sin compromiso."
  />
</BaseLayout>
