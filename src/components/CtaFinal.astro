---
// Sección CTA final oscura, al cierre de cada página.
import Button from './Button.astro';

const {
  title = 'Míralo con tus<br />propias propiedades.',
  text = 'Nos cuentas cómo arriendas y cobras hoy, y te mostramos cómo quedaría con tus propios inmuebles. Treinta minutos, sin compromiso.',
} = Astro.props;
---
<section class="section-dark cta-final" id="demo">
  <div class="wrap">
    <h2 class="display-lg reveal" style="color: var(--fg-on-dark);" set:html={title} />
    <p class="lede reveal">{text}</p>
    <div class="hero-actions reveal">
      <Button action="demo" variant="on-dark" size="lg" />
    </div>
  </div>
</section>
