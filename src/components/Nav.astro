---
// Nav píldora: mega-menú "Plataforma" (desktop) + panel desplegable (móvil).
// Las columnas salen de NAV_GROUPS — sistema base primero, luego las tres
// suites — así que agregar un módulo no obliga a tocar este componente.
import { NAV_GROUPS, SISTEMA_BASE, LIVIA } from '../lib/platform.js';
import { YAMPI_APP_URL } from '../lib/site-copy.js';
import Button from './Button.astro';
import Logo from './Logo.astro';
---
<header class="nav-shell" data-nav-shell>
  <nav class="nav-pill">
    <a class="nav-logo" href="/" aria-label="Yampi"><Logo height={26} /></a>
    <div class="nav-links">
      <div class="nav-item-wrap">
        <button class="nav-item" type="button" aria-expanded="false">
          Plataforma
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
        </button>
        <div class="mega">
          {NAV_GROUPS.map((g) => (
            <div class="mega-col">
              <h5 style={`color: ${g.color}`}>{g.label}</h5>
              {g.items.map((item) => <a href={g.href}>{item}</a>)}
            </div>
          ))}
        </div>
      </div>
      <a class="nav-item" href={LIVIA.href}>Livia</a>
      <a class="nav-item" href={SISTEMA_BASE.href}>Sistema base</a>
      <a class="nav-item" href="/#plataforma">Plataforma completa</a>
    </div>
    <div class="nav-right">
      <a class="nav-login" href={YAMPI_APP_URL} target="_blank" rel="noopener">Iniciar sesión</a>
      <Button action="demo" />
    </div>
    <button
      class="nav-burger"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="nav-mobile"
      data-nav-burger
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="7" x2="21" y2="7" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="17" x2="21" y2="17" />
      </svg>
    </button>
  </nav>

  <div class="nav-mobile" id="nav-mobile" hidden>
    <div class="nav-mobile-inner">
      {NAV_GROUPS.map((g) => (
        <div class="nav-mobile-group">
          <h5 style={`color: ${g.color}`}>{g.label}</h5>
          {g.items.map((item) => <a href={g.href}>{item}</a>)}
        </div>
      ))}
      <div class="nav-mobile-group">
        <h5>Explora</h5>
        <a href={LIVIA.href}>Livia</a>
        <a href="/#plataforma">Plataforma completa</a>
      </div>
      <div class="nav-mobile-actions">
        <Button action="demo" size="lg" />
        <a class="btn btn-outline btn-lg" href={YAMPI_APP_URL} target="_blank" rel="noopener">Iniciar sesión</a>
      </div>
    </div>
  </div>
</header>

<script>
  const shell = document.querySelector('[data-nav-shell]');
  if (shell) {
    const SCROLL_THRESHOLD = 24;
    const syncNav = () => {
      shell.classList.toggle('is-scrolled', window.scrollY > SCROLL_THRESHOLD);
    };
    syncNav();
    window.addEventListener('scroll', syncNav, { passive: true });
  }

  const burger = document.querySelector('[data-nav-burger]');
  const panel = document.getElementById('nav-mobile');

  if (burger && panel) {
    const setOpen = (open) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      panel.hidden = !open;
      document.body.classList.toggle('nav-locked', open);
    };

    burger.addEventListener('click', () =>
      setOpen(burger.getAttribute('aria-expanded') !== 'true')
    );

    // Un enlace a un ancla de la misma página no recarga, así que hay que cerrar
    // a mano. El botón de demo también: abre el popup del calendario y el panel
    // se quedaría detrás del modal.
    panel.addEventListener('click', (e) => {
      if (e.target instanceof Element && e.target.closest('a, [data-yampi-demo]')) {
        setOpen(false);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        burger.focus();
      }
    });

    // Al cruzar a desktop el panel deja de mostrarse por CSS: sincroniza el estado.
    window
      .matchMedia('(min-width: 1000px)')
      .addEventListener('change', (e) => {
        if (e.matches) setOpen(false);
      });
  }
</script>
