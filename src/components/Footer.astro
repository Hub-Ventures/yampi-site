---
// Footer oscuro, con las mismas columnas del mega-menú.
import { NAV_GROUPS } from '../lib/platform.js';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <Logo height={28} />
        <p style="margin-top: 14px; max-width: 260px;">La plataforma todo-en-uno para operar tu inmobiliaria de punta a punta en Latinoamérica.</p>
      </div>
      {NAV_GROUPS.map((g) => (
        <div>
          <h5>{g.label}</h5>
          {g.items.map((item) => (
            <a href={g.href} style="display: block;">{item}</a>
          ))}
        </div>
      ))}
    </div>
    <div class="footer-bottom">
      <span>© {year} Yampi. Todos los derechos reservados.</span>
      {/* Sin barra final, a propósito: la verificación OAuth de Google compara
          carácter por carácter la URL de la Cloud Console
          (https://yampi.ai/privacy) contra la enlazada en la home, y ya rechazó
          una vez por ese desajuste. El signup de la app enlaza a las mismas. */}
      <nav class="footer-legal" aria-label="Legal">
        <a href="/terms">Términos y Condiciones</a>
        <a href="/privacy">Política de Privacidad</a>
      </nav>
    </div>
  </div>
</footer>
